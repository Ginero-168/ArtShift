# Required for the AI Agent (Chat Bubble)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override default Anthropic model
ANTHROPIC_MODEL=claude-sonnet-4-5

# Replicate API Token (alternative AI backend for Claude via Replicate)
# Get your token at: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_...

# Google AI Studio API Key (Gemini) — /api/generate
GEMINI_API_KEY=...

# WaveSpeed AI Key — /api/removebg (background removal)
WAVESPEED_API_KEY=...

# Unsplash Access Key — /api/unsplash
UNSPLASH_ACCESS_KEY=...

# Pexels API Key — /api/pexels
PEXELS_API_KEY=...

# Optional paid Fast raster provider. If omitted, /api/raster/process uses
# the bounded local Node implementation so self-hosted/free mode still works.
RASTER_API_URL=https://your-raster-provider.example/process
RASTER_API_KEY=...
