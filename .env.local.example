# Google OAuth is the primary account login for persistent BYOK.
# Register this exact redirect URI in Google Cloud Console:
# http://localhost:3000/api/auth/google/callback
ARTSHIFT_PUBLIC_URL=http://localhost:3000
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret

# Generate 32-byte base64url values for both keys. Never commit real values.
ARTSHIFT_AUTH_SESSION_KEY=replace-with-32-byte-base64url-key
ARTSHIFT_CREDENTIAL_ENCRYPTION_KEY=replace-with-another-32-byte-base64url-key

# Optional: an Anthropic adapter for deployments that explicitly enable its routes.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override default Anthropic model
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional cloud Vision providers. Remove BG, Extract and raster AI tools remain local-only.
# Replicate model wrapper versions are server-side routing metadata only.
# Users provide their own Replicate API Key in AI Provider Settings.
REPLICATE_GPT4O_MINI_VERSION=7a6099b47d623cc4a5c75037ab4616059a7066dec31fdbe409d671bddf7681d
REPLICATE_GEMINI_3_FLASH_VERSION=e27b7b83f67f5865920667591a2a08a41cdc82906bd29306fe79581ab0646b8b

# Optional direct provider fallbacks. They are never used unless policy permits fallback.
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# AI Image Studio provider. Use a server secret key, never a browser app key here.
POLLINATIONS_API_KEY=sk_...
# Optional server-owned model mapping for stable UI aliases.
POLLINATIONS_MODEL_PRIMARY=flux
POLLINATIONS_MODEL_REALISM=flux
POLLINATIONS_MODEL_ANIME=flux
POLLINATIONS_MODEL_3D=flux
POLLINATIONS_MODEL_FAST=turbo

# Optional ArtShift budget guard. Cost remains estimated when a provider omits usage.
AI_MONTHLY_BUDGET_USD=25

# Unsplash Access Key — /api/unsplash
UNSPLASH_ACCESS_KEY=...

# Pexels API Key — /api/pexels
PEXELS_API_KEY=...

# Optional paid Fast raster provider. If omitted, /api/raster/process uses
# the bounded local Node implementation so self-hosted/free mode still works.
RASTER_API_URL=https://your-raster-provider.example/process
RASTER_API_KEY=...
