{
  "name": "artshift",
  "version": "0.1.0",
  "private": true,
  "description": "ArtShift — AI-powered slide and design studio with a Canvas2D editor, local vision AI, and background removal.",
  "engines": {
    "node": ">=22.23.2 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check app components lib tests next.config.ts postcss.config.mjs vitest.config.ts",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "benchmark:raster": "vitest bench tests/rasterProcessor.bench.ts --run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "audit:prod": "npm audit --omit=dev",
    "check:deps": "npm outdated"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@huggingface/transformers": "^4.2.0",
    "@techstark/opencv-js": "^5.0.0-release.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "nanoid": "^5.1.16",
    "next": "^15.5.23",
    "pdfjs-dist": "^6.2.108",
    "perfect-freehand": "^1.2.3",
    "polygon-clipping": "^0.15.7",
    "pptxgenjs": "^4.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "roughjs": "^4.6.6",
    "valibot": "^1.4.2",
    "zustand": "^5.0.1"
  },
  "overrides": {
    "adm-zip": "^0.6.0",
    "dompurify": "^3.4.13",
    "next": {
      "nanoid": "3.3.18",
      "postcss": "^8.5.23"
    },
    "protobufjs": "^7.6.5",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@testing-library/react": "^16.3.2",
    "@types/jszip": "^3.4.0",
    "@types/node": "^22.9.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/ui": "^4.1.4",
    "happy-dom": "^20.9.0",
    "jsdom": "^29.0.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  }
}
